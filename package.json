{
  "name": "fitlocale",
  "version": "0.1.0",
  "description": "Catch translation-caused layout bugs (overflow, text leaks, RTL mirroring) in your Playwright tests.",
  "keywords": [
    "playwright",
    "i18n",
    "l10n",
    "localization",
    "internationalization",
    "pseudo-localization",
    "rtl",
    "right-to-left",
    "arabic",
    "hebrew",
    "text-overflow",
    "truncation",
    "testing",
    "visual-testing",
    "ci"
  ],
  "homepage": "https://github.com/melliforge/localization-layout-tester#readme",
  "bugs": {
    "url": "https://github.com/melliforge/localization-layout-tester/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melliforge/localization-layout-tester.git"
  },
  "author": "melliforge",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./playwright": {
      "import": {
        "types": "./dist/playwright.d.ts",
        "default": "./dist/playwright.js"
      },
      "require": {
        "types": "./dist/playwright.d.cts",
        "default": "./dist/playwright.cjs"
      }
    },
    "./reporter": {
      "import": {
        "types": "./dist/reporter.d.ts",
        "default": "./dist/reporter.js"
      },
      "require": {
        "types": "./dist/reporter.d.cts",
        "default": "./dist/reporter.cjs"
      }
    }
  },
  "bin": {
    "fitlocale": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:browser": "node scripts/build-browser.mjs",
    "build": "npm run build:browser && tsup",
    "test": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.45.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
